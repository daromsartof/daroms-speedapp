{
  "name": "@daromsart/daroms-speed-app",
  "version": "0.2.0",
  "description": "Framework mobile Expo + Tamagui v3 + Supabase pour Claude Code : thème, composants, données, modules, CLI daroms et couche IA, pour sortir une app par jour.",
  "license": "MIT",
  "author": "Daroms",
  "homepage": "https://daromsartof.github.io/daroms-speedapp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daromsartof/daroms-speedapp.git"
  },
  "bugs": {
    "url": "https://github.com/daromsartof/daroms-speedapp/issues"
  },
  "keywords": [
    "expo",
    "react-native",
    "tamagui",
    "supabase",
    "claude",
    "claude-code",
    "framework",
    "mobile",
    "cli",
    "expo-router",
    "eas",
    "starter",
    "ai"
  ],
  "engines": {
    "node": ">=22.18",
    "bun": ">=1.3"
  },
  "bin": {
    "daroms": "cli/daroms.ts"
  },
  "files": [
    "cli",
    "!cli/tests",
    "packages",
    "modules",
    "!modules/__typetest__",
    "template",
    "generators",
    "_ai",
    "!_ai/hooks/tests",
    "!**/__tests__",
    "!**/__typetest__",
    "!**/__pycache__",
    "VERSION",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "daroms": "bun cli/daroms.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "test:cli": "bun test ./cli",
    "test:hooks": "python3 -m unittest discover -s _ai/hooks/tests",
    "catalog": "bun cli/daroms.ts catalog",
    "docs:dev": "cd docs && bun install && bun run dev",
    "docs:check": "cd docs && bun install && bun run check",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:cli && bun run test:hooks",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@react-native/jest-preset": "^0.88.0",
    "@resvg/resvg-js": "^2.6.2",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tamagui/animation-helpers": "3.1.2",
    "@tamagui/animations-react-native": "3.1.2",
    "@tamagui/animations-reanimated": "3.1.2",
    "@tamagui/cli": "3.1.2",
    "@tamagui/config": "3.1.2",
    "@tamagui/font-inter": "3.1.2",
    "@tamagui/helpers-icon": "3.1.2",
    "@tamagui/themes": "3.1.2",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react-native": "^14.1.0",
    "@types/bun": "^1.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo": "~58.0.17",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.18",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "i18next": "^26.5.5",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-purchases": "^10.15.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tamagui": "3.1.2",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
