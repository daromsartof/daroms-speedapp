{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun daroms:*)",
      "Bash(bun core/cli/daroms.ts:*)",
      "Bash(bun install)",
      "Bash(bun run:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx eslint:*)",
      "Bash(bunx jest:*)",
      "Bash(bunx prettier:*)",
      "Bash(bunx expo install:*)",
      "Bash(python3 .claude/hooks/daroms-context.py test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read(./core/packages/ui/CATALOG.md)",
      "Read(./app.spec.md)",
      "Read(./.daroms/inspiration/**)",
      "WebSearch",
      "WebFetch(domain:dribbble.com)",
      "WebFetch(domain:pinterest.com)",
      "WebFetch(domain:www.pinterest.com)",
      "WebFetch(domain:behance.net)",
      "WebFetch(domain:www.behance.net)",
      "WebFetch(domain:mobbin.com)",
      "WebFetch(domain:screensdesign.com)",
      "WebFetch(domain:pageflows.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Edit(./core/**)",
      "Write(./core/**)",
      "Edit(./src/generated/**)",
      "Write(./src/generated/**)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/core/_ai/hooks/daroms-sync.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/daroms-context.py\" build",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/daroms-context.py\" route",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/daroms-check-rules.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/daroms-deny-env.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/daroms-typecheck.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/daroms-session-stats.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "frontend-design": "name-only",
    "expo-native-ui": "name-only",
    "expo-data-fetching": "name-only",
    "eas-app-stores": "name-only",
    "expo-upgrade": "name-only",
    "expo-animation": "name-only",
    "react-native-best-practices": "name-only",
    "supabase-postgres-best-practices": "name-only",
    "supabase": "name-only",
    "ecc-tdd-workflow": "name-only",
    "ecc-security-review": "name-only",
    "ecc-accessibility": "name-only",
    "ecc-typescript-patterns": "name-only"
  }
}
