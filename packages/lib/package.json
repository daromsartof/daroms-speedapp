{
  "name": "@daroms/lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fonctions pures et utilitaires : formats, zod partagé, stockage (MMKV), haptique, manifest",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./storage": "./src/storage.ts",
